#!/usr/bin/python3
"""Copy Nostr, Bitcoin and freedom tech posts from the ninepointlabs blog into this blog.

Tim writes posts only in ~/Blogs/ninepointlabs-blog. This script makes generated copies
in posts/ninepointlabs/ here. It runs from build.pre in both blogs' blog.toml, so the
folderblog watcher picks up a new matching post on its own.

A post is copied when one of its tags slugs to nostr, bitcoin, lightning or freedom-tech,
or its front matter says `pleb: true`. `pleb: false` keeps it out even if tagged.
Drafts never sync.

Each copy keeps the original front matter and Markdown, adds `canonical` (the
blog.ninepointlabs.com permalink) and `origin: ninepointlabs`, and has relative links
rewritten to absolute blog.ninepointlabs.com URLs. A file is written only when its
content changes, and copies whose source no longer matches are removed. If the source
blog can't be read, nothing is changed and the script exits 1.

Env: NPL_BLOG (source folder, default ~/Blogs/ninepointlabs-blog), FOLDERBLOG (binary).
"""

import fcntl
import json
import os
import posixpath
import re
import subprocess
import sys
import tomllib
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
SRC = Path(os.environ.get("NPL_BLOG", Path.home() / "Blogs" / "ninepointlabs-blog"))
OUT = HERE / "posts" / "ninepointlabs"
FOLDERBLOG = os.environ.get("FOLDERBLOG", "folderblog")
MARKER = "# Generated by bin/sync-from-ninepointlabs."
TAGS = {"nostr", "bitcoin", "lightning", "freedom-tech"}
PREFILTER = re.compile(r"nostr|bitcoin|lightning|freedom|pleb", re.I)


def log(msg):
    print(f"sync-from-ninepointlabs: {msg}", file=sys.stderr)


def data(*args):
    cmd = [FOLDERBLOG, "data", "--blog", str(SRC), *args]
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    if r.returncode != 0:
        raise RuntimeError(f"{' '.join(cmd)} failed: {r.stderr.strip()[-500:]}")
    return r.stdout


def truthy(v):
    if isinstance(v, str):
        return v.strip().lower() in ("true", "yes", "1", "on")
    return v is True or v == 1


def wanted(item):
    if item.get("draft"):
        return False
    meta = item.get("meta") or {}
    if "pleb" in meta and not truthy(meta["pleb"]):
        return False
    if truthy(meta.get("pleb")):
        return True
    return any(t.get("slug") in TAGS for t in item.get("tags") or [])


# --- link rewriting -----------------------------------------------------------------

ABSOLUTE = re.compile(r"^(?:[a-zA-Z][a-zA-Z0-9+.-]*:|//|#)")


def resolver(item, base, url_of_source):
    source_dir = posixpath.dirname(item["source"])
    bundle_files = {f["name"]: f["url"] for f in item.get("files") or []}
    is_bundle = item["source"].endswith("/index.md")

    def resolve(target):
        if not target or ABSOLUTE.match(target):
            return target
        path, sep, rest = _split(target)
        if target.startswith("/"):
            return base + target
        joined = posixpath.normpath(posixpath.join(source_dir, path))
        if joined in url_of_source:
            return base + url_of_source[joined] + sep + rest
        if is_bundle and posixpath.dirname(joined) == source_dir and posixpath.basename(joined) in bundle_files:
            return base + bundle_files[posixpath.basename(joined)] + sep + rest
        if joined.startswith("pages/"):
            return base + "/" + joined[len("pages/"):] + sep + rest
        return base + "/" + joined + sep + rest

    return resolve


def _split(target):
    m = re.search(r"[?#]", target)
    if not m:
        return target, "", ""
    return target[: m.start()], target[m.start()], target[m.start() + 1 :]


MD_LINK = re.compile(r"(\]\(\s*<?)([^)\s>]+)")
MD_REF = re.compile(r"^(\s{0,3}\[[^\]]+\]:\s*<?)(\S+?)(>?(?:\s|$))", re.M)
HTML_ATTR = re.compile(r"""(\b(?:src|href|poster)\s*=\s*["'])([^"']*)""", re.I)
FENCE = re.compile(r"^\s{0,3}(```|~~~)")
INLINE_CODE = re.compile(r"(`+)(?:.|\n)*?\1")


def rewrite_links(md, resolve):
    out, in_fence, fence = [], False, ""
    chunk = []

    def flush():
        if not chunk:
            return
        text = "".join(chunk)
        # Leave inline code spans alone.
        parts, last = [], 0
        for m in INLINE_CODE.finditer(text):
            parts.append(fix(text[last : m.start()]))
            parts.append(m.group(0))
            last = m.end()
        parts.append(fix(text[last:]))
        out.append("".join(parts))
        chunk.clear()

    def fix(s):
        s = MD_LINK.sub(lambda m: m.group(1) + resolve(m.group(2)), s)
        s = MD_REF.sub(lambda m: m.group(1) + resolve(m.group(2)) + m.group(3), s)
        s = HTML_ATTR.sub(lambda m: m.group(1) + resolve(m.group(2)), s)
        return s

    for line in md.splitlines(keepends=True):
        m = FENCE.match(line)
        if in_fence:
            out.append(line)
            if m and m.group(1) == fence:
                in_fence = False
            continue
        if m:
            flush()
            in_fence, fence = True, m.group(1)
            out.append(line)
            continue
        chunk.append(line)
    flush()
    return "".join(out)


# --- writing --------------------------------------------------------------------------

PLAIN_KEY = re.compile(r"^[A-Za-z_][A-Za-z0-9_-]*$")


def front_matter(meta):
    lines = []
    for k, v in meta.items():
        key = k if PLAIN_KEY.match(k) else json.dumps(k, ensure_ascii=False)
        lines.append(f"{key}: {json.dumps(v, ensure_ascii=False)}")
    return "\n".join(lines)


def render_copy(item, base, url_of_source):
    meta = {k: v for k, v in (item.get("meta") or {}).items() if k not in ("draft",)}
    meta.setdefault("date", item["date"])
    meta["slug"] = item["slug"]
    if item.get("image"):
        meta["image"] = item["image"]
    meta["canonical"] = item["permalink"]
    meta["origin"] = "ninepointlabs"
    body = rewrite_links(item["raw"], resolver(item, base, url_of_source))
    head = f"{MARKER} Edit the original instead: {SRC.name}/{item['source']}"
    return f"---\n{head}\n{front_matter(meta)}\n---\n{body.lstrip(chr(10))}"


def write_if_changed(path, text):
    data_ = text.encode()
    if path.exists() and path.read_bytes() == data_:
        return False
    tmp = path.with_name(f".{path.name}.tmp")
    tmp.write_bytes(data_)
    os.replace(tmp, path)
    return True


def main():
    if not (SRC / "blog.toml").is_file():
        log(f"{SRC}/blog.toml not found; nothing changed")
        return 1
    base = tomllib.loads((SRC / "blog.toml").read_text())["base_url"].rstrip("/")

    url_of_source = {}
    for line in data().splitlines():
        url, _, origin = line.partition("\t")
        source = origin.split(" (via ")[0]
        if source.startswith("posts/") and source.endswith(".md"):
            url_of_source[source] = url
    if not url_of_source:
        log("source blog lists no posts; refusing to change anything")
        return 1

    copies = {}
    for source, url in url_of_source.items():
        try:
            text = (SRC / source).read_text(errors="replace")
        except OSError:
            continue
        if not PREFILTER.search(text):
            continue
        item = json.loads(data(url))["item"]
        if wanted(item):
            name = Path(source).name if not source.endswith("/index.md") else Path(source).parent.name + ".md"
            copies[name] = render_copy(item, base, url_of_source)

    OUT.mkdir(parents=True, exist_ok=True)
    changed = []
    for name, text in sorted(copies.items()):
        if write_if_changed(OUT / name, text):
            changed.append(f"wrote {name}")
    for old in sorted(OUT.glob("*.md")):
        if old.name not in copies and old.read_text(errors="replace").startswith(f"---\n{MARKER}"):
            old.unlink()
            changed.append(f"removed {old.name}")
    for c in changed:
        log(c)
    return 0


if __name__ == "__main__":
    lock_dir = HERE / ".blog"
    lock_dir.mkdir(exist_ok=True)
    with open(lock_dir / "sync.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            sys.exit(main())
        except Exception as e:  # report briefly; folderblog shows stderr on failure
            log(f"error: {e}")
            sys.exit(1)
